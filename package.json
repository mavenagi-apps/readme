{
  "type": "module",
  "scripts": {
    "build": "next build",
    "badges": "tsx scripts/update-version-badges.ts && pnpm run test:coverage",
    "commitlint": "commitlint --edit",
    "dev": "next dev",
    "format": "prettier --log-level warn --write \"**/*.{js,cjs,mjs,json,ts,mts,cts,tsx,md,mdx,yml,yaml}\"",
    "lint": "next lint",
    "lint:format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "lint:format:package": "prettier-package-json --write ./package.json",
    "lint-staged": "lint-staged",
    "start": "next start",
    "tag:version": "git tag v$(node -p \"require('./package.json').version\") && git push --tags",
    "test": "pnpm test:vitest && pnpm test:recorded",
    "test:coverage": "vitest run --coverage && tsx scripts/update-coverage-badge.ts",
    "test:record": "NEVE_RECORD=true pnpm run test:recorded",
    "test:recorded": "vitest --config vitest.recorded.config.js run",
    "test:vitest": "vitest run",
    "test:vitest:coverage": "vitest run --coverage.enabled --coverage.reporter='text-summary'"
  },
  "dependencies": {
    "@vercel/functions": "3.3.4",
    "bottleneck": "^2.19.5",
    "eld": "^1.0.1",
    "inngest": "^3.54.0",
    "mavenagi": "1.2.8",
    "next": "15.1.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@inngest/test": "0.1.3",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "5.5.3",
    "vite-tsconfig-paths": "5.1.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": "^22.11.0",
    "pnpm": ">=10.3.0"
  },
  "packageManager": "pnpm@10.3.0"
}
